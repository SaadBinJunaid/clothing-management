# Firebase configuration template
# --------------------------------
# 1. Copy this file and name the copy ".env" (same folder).
#    Do NOT type your real keys into this template file — it is meant to be
#    shared/committed with empty values. Your real keys belong in ".env".
# 2. Open Firebase console -> Project settings -> Your apps -> SDK setup and configuration -> Config.
# 3. Copy each value into .env next to the matching name, then restart the dev server (npm run dev).
#
# Notes:
# - Vite only exposes environment variables whose name starts with "VITE_" to the browser.
#   That is normal: this config identifies your Firebase project, it is not a secret by itself.
#   Your data is protected by the security rules in firestore.rules, not by hiding these keys.
# - Never put service-account private keys or passwords in this file.
# - The real .env file is listed in .gitignore so it is never committed.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional. Only needed if you later switch on Firebase Analytics; this project
# does not use Analytics, so you can leave it empty. Looks like G-XXXXXXXXXX.
VITE_FIREBASE_MEASUREMENT_ID=
